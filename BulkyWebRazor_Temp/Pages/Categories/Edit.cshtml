@page
@model BulkyWebRazor_Temp.Pages.Categories.EditModel


<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Edit Category</h2>
            <hr />
        </div>
        <div asp-validation-summary="All"></div> <!--shows a summary of all current input errors   Try All/ModelOnly/None option-->
        <input asp-for="Category.Id" hidden />
        @*//above PK hidden input - not necessary as it is called Id but you may need to include if your PK is not standard*@
        <div class="mb-3 row p-1">
            <label asp-for="Category.Name" class="p-0"></label>
            <input asp-for="Category.Name" class="form-control" />
            <span asp-validation-for="Category.Name" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Category.DisplayOrder" class="p-0"></label>
            <input asp-for="Category.DisplayOrder" class="form-control" />
            <span asp-validation-for="Category.DisplayOrder" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6 col-md-3">
            <button type="submit" class="btn btn-primary form-control">Edit Category</button>
        </div>
        <div class="col-6 col-md-3">
            <a asp-page="/Categories/Index" class="btn btn-outline-secondary border form-control">
                Back to List
            </a>
        </div>
    </div>

</form>

<!--Adds the validtiaon script for client side validation-->
@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}